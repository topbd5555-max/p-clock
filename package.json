"build": {
  "appId": "com.pclock.app",
  "productName": "P-Clock",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*"
  ],
  "asarUnpack": [
    "**/node_modules/sql.js/**"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "public/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  },
  "publish": [
    {
      "provider": "github",
      "owner": "topbd5555-max",
      "repo": "p-clock",
      "releaseType": "release"
    }
  ]
}